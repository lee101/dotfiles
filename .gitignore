# Uninteresting files generated by vim.
secrets
/vim/.netrwhist
/vim/backup/*
/vim/bundle/
/vim/doc/tags
/vim/managed-addons/
/vim/sessions/
/vim/temp/*

# Subversion server credentials.
/subversion/auth/svn.*

npmrc
*.swp
.idea
.idea/
idea/*

# SSH sensitive files
.ssh/.sshpass
bin/ssh-daisy
bin/ssh-lee3090ti
bin/setup-ssh-keys.sh

# Screenshots directory
screenshots/
gitconfig.remote
tools/btop

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Compiled go tools (built from tools/cmd via build.sh)
/tools/gtree
tools/netwrck-route-prof
# go-line-profiler binary (built in place via `go build` in its module dir)
/tools/golang/go-line-profiler/go-line-profiler
/tools/golang/go-line-profiler/go-line-profiler.exe
