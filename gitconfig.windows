# Windows-specific git config overrides
# Link via linkdotfiles.ps1 or include from main .gitconfig:
#   [include]
#       path = ~/.gitconfig.windows

[core]
    # Windows line ending handling (safer default on Win)
    autocrlf = true
    # Git Bash / FS perms
    filemode = false
    # Enable long paths (requires git >= 2.22 + windows config)
    longpaths = true
    # symlinks often need extra setup on Windows
    symlinks = false
    # Use delta if present (common on Win via winget)
    pager = delta --paging=never

[credential]
    # Use Windows Credential Manager
    helper = manager

[init]
    defaultBranch = main

[fetch]
    prune = true

[pull]
    rebase = false

[safe]
    # Allow in dev containers / mounts common on Win
    directory = *
