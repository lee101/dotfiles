#!/bin/bash

# Cross-platform utility functions
# Source this file in your bashrc for unified commands across Mac, Linux, WSL, Git Bash (MINGW/MSYS), Cygwin
# PLATFORM values: Mac | Linux | WSL | Git | Cygwin | UNKNOWN:...

# Detect platform (improved for WSL, Git Bash variants, MSYS2)
detect_platform() {
    # WSL detection (must come before generic Linux*) - robust checks
    if [ -n "${WSL_DISTRO_NAME:-}" ] || \
       [ -f /proc/sys/fs/binfmt_misc/WSLInterop ] 2>/dev/null; then
        echo "WSL"
        return
    fi
    if [ -r /proc/version ] 2>/dev/null && grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
        echo "WSL"
        return
    fi
    local unameOut
    unameOut="$(uname -s 2>/dev/null || echo UNKNOWN)"
    case "${unameOut}" in
        Linux*)     echo "Linux";;
        Darwin*)    echo "Mac";;
        CYGWIN*)    echo "Cygwin";;
        MINGW*|MSYS*) echo "Git";;
        *)          echo "UNKNOWN:${unameOut}";;
    esac
}

PLATFORM=$(detect_platform)

# Convert a Unix-style path (., .., /c/foo, relative, etc.) to a native Windows path
# that explorer.exe / other Win32 tools understand. Works in Git Bash (cygpath)
# and WSL (wslpath).
_to_windows_path() {
    local p="${1:-.}"
    # Expand leading ~ safely (common when user types o ~ or explorer ~)
    case "$p" in
        ~|~/*) p="${p/#\~/$HOME}" ;;
    esac
    case "$PLATFORM" in
        WSL)
            if command -v wslpath >/dev/null 2>&1; then
                wslpath -w -a "$p" 2>/dev/null || echo "$p"
            else
                echo "$p"
            fi
            ;;
        Git|Cygwin)
            if command -v cygpath >/dev/null 2>&1; then
                cygpath -w -a "$p" 2>/dev/null || echo "$p"
            else
                echo "$p"
            fi
            ;;
        *)
            echo "$p"
            ;;
    esac
}

# Interactive shells may define aliases that share names with helpers below.
# Clear the known collisions before the function definitions are parsed so
# alias expansion cannot break or silently rewrite them.
for _cross_platform_alias in compress reswap; do
    builtin unalias "$_cross_platform_alias" 2>/dev/null || true
done
unset _cross_platform_alias

# Retrieve sudo password from current env or ~/.secretbashrc.
# SUDO_PW is the cross-platform name; MAC_PW is kept for existing macOS setups.
_get_sudo_password() {
    if [ -n "${SUDO_PW:-}" ]; then
        printf '%s' "$SUDO_PW"
        return 0
    fi

    if [ -n "${MAC_PW:-}" ]; then
        printf '%s' "$MAC_PW"
        return 0
    fi

    local secret_file="$HOME/.secretbashrc"
    if [ -f "$secret_file" ]; then
        # shellcheck disable=SC1090
        . "$secret_file"
        if [ -n "${SUDO_PW:-}" ]; then
            printf '%s' "$SUDO_PW"
            return 0
        fi
        if [ -n "${MAC_PW:-}" ]; then
            printf '%s' "$MAC_PW"
            return 0
        fi
    fi

    return 1
}

sudo_run() {
    local pw
    if pw="$(_get_sudo_password)"; then
        printf '%s\n' "$pw" | sudo -S "$@"
    else
        sudo "$@"
    fi
}

# Package manager abstraction
pkg_install() {
    case "$PLATFORM" in
        Mac)
            brew install "$@"
            ;;
        Linux)
            if command -v apt-get >/dev/null 2>&1; then
                sudo_run apt-get install -y "$@"
            elif command -v yum >/dev/null 2>&1; then
                sudo_run yum install -y "$@"
            elif command -v pacman >/dev/null 2>&1; then
                sudo_run pacman -S --noconfirm "$@"
            else
                echo "No supported package manager found"
                return 1
            fi
            ;;
        Git|Cygwin|WSL)
            if command -v choco >/dev/null 2>&1; then
                choco install -y "$@"
            elif command -v scoop >/dev/null 2>&1; then
                scoop install "$@"
            else
                echo "Please install Chocolatey or Scoop for Windows package management"
                return 1
            fi
            ;;
        *)
            echo "Unsupported platform: $PLATFORM"
            return 1
            ;;
    esac
}

# Package update abstraction
pkg_update() {
    case "$PLATFORM" in
        Mac)
            brew update && brew upgrade
            ;;
        Linux)
            if command -v apt-get >/dev/null 2>&1; then
                sudo_run apt-get update && sudo_run apt-get upgrade -y
            elif command -v yum >/dev/null 2>&1; then
                sudo_run yum update -y
            elif command -v pacman >/dev/null 2>&1; then
                sudo_run pacman -Syu --noconfirm
            fi
            ;;
        Git|Cygwin|WSL)
            if command -v choco >/dev/null 2>&1; then
                choco upgrade all -y
            elif command -v scoop >/dev/null 2>&1; then
                scoop update && scoop update *
            fi
            ;;
    esac
}

# Service management abstraction
service_start() {
    local service=$1
    case "$PLATFORM" in
        Mac)
            brew services start "$service"
            ;;
        Linux)
            if command -v systemctl >/dev/null 2>&1; then
                sudo_run systemctl start "$service"
            elif command -v service >/dev/null 2>&1; then
                sudo_run service "$service" start
            fi
            ;;
        Git|Cygwin|WSL)
            sc start "$service" 2>/dev/null || net start "$service"
            ;;
    esac
}

service_stop() {
    local service=$1
    case "$PLATFORM" in
        Mac)
            brew services stop "$service"
            ;;
        Linux)
            if command -v systemctl >/dev/null 2>&1; then
                sudo_run systemctl stop "$service"
            elif command -v service >/dev/null 2>&1; then
                sudo_run service "$service" stop
            fi
            ;;
        Git|Cygwin|WSL)
            sc stop "$service" 2>/dev/null || net stop "$service"
            ;;
    esac
}

service_status() {
    local service=$1
    case "$PLATFORM" in
        Mac)
            brew services list | grep "$service"
            ;;
        Linux)
            if command -v systemctl >/dev/null 2>&1; then
                systemctl status "$service"
            elif command -v service >/dev/null 2>&1; then
                service "$service" status
            fi
            ;;
        Git|Cygwin|WSL)
            sc query "$service" 2>/dev/null || net start | grep "$service"
            ;;
    esac
}

# Process management abstraction
kill_port() {
    local port=$1
    case "$PLATFORM" in
        Mac)
            lsof -ti:$port | xargs kill -9 2>/dev/null || echo "No process on port $port"
            ;;
        Linux)
            sudo_run fuser -k $port/tcp 2>/dev/null || echo "No process on port $port"
            ;;
        Git|Cygwin|WSL)
            netstat -ano | grep ":$port" | awk '{print $5}' | xargs -I {} taskkill /F /PID {} 2>/dev/null || \
            powershell.exe -command "Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess | ForEach-Object { taskkill /F /PID \$_ }" 2>/dev/null || echo "No process on port $port"
            ;;
    esac
}

# Find process by name
find_process() {
    local name=$1
    case "$PLATFORM" in
        Mac|Linux)
            ps aux | grep -i "$name" | grep -v grep
            ;;
        Git|Cygwin|WSL)
            tasklist | grep -i "$name" 2>/dev/null || powershell.exe -command "Get-Process *$name* -ErrorAction SilentlyContinue | Select-Object Name, Id, CPU"
            ;;
    esac
}

# Network utilities
get_local_ip() {
    case "$PLATFORM" in
        Mac)
            ifconfig | grep "inet " | grep -v 127.0.0.1 | awk '{print $2}' | head -1
            ;;
        Linux)
            ip route get 8.8.8.8 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1
            ;;
        Git|Cygwin|WSL)
            ipconfig | grep -A 4 "Wireless LAN adapter Wi-Fi" | grep "IPv4" | awk '{print $NF}' 2>/dev/null || \
            powershell.exe -command "(Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '169.*' -and $_.IPAddress -notlike '127.*' } | Select-Object -First 1).IPAddress" 2>/dev/null || echo "127.0.0.1"
            ;;
    esac
}

# File system utilities
trash_file() {
    case "$PLATFORM" in
        Mac)
            if command -v trash >/dev/null 2>&1; then
                trash "$@"
            else
                mv "$@" ~/.Trash/
            fi
            ;;
        Linux)
            if command -v trash-put >/dev/null 2>&1; then
                trash-put "$@"
            elif command -v gio >/dev/null 2>&1; then
                gio trash "$@"
            else
                mkdir -p ~/.local/share/Trash/files
                mv "$@" ~/.local/share/Trash/files/
            fi
            ;;
        Git|Cygwin|WSL)
            # Move to Windows Recycle Bin (best effort)
            powershell.exe -command "Move-Item -Path '$@' -Destination 'shell:RecycleBinFolder' -ErrorAction SilentlyContinue" 2>/dev/null || \
            rm -rf "$@"   # fallback
            ;;
    esac
}

# System information
sys_info() {
    echo "Platform: $PLATFORM"
    echo "Hostname: $(hostname)"
    echo "User: $USER"
    echo "Shell: $SHELL"
    echo "Local IP: $(get_local_ip)"
    
    case "$PLATFORM" in
        Mac)
            echo "macOS Version: $(sw_vers -productVersion)"
            echo "CPU: $(sysctl -n machdep.cpu.brand_string)"
            echo "Memory: $(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 )) GB"
            ;;
        Linux)
            echo "Kernel: $(uname -r)"
            if [ -f /etc/os-release ]; then
                . /etc/os-release
                echo "Distribution: $NAME $VERSION"
            fi
            echo "CPU: $(grep "model name" /proc/cpuinfo | head -1 | cut -d: -f2)"
            echo "Memory: $(free -h | grep Mem | awk '{print $2}')"
            ;;
        Git|Cygwin|WSL)
            echo "Windows Version: $(cmd.exe /c ver 2>/dev/null | grep -o '[0-9.]*')"
            echo "CPU: $(wmic cpu get name 2>/dev/null | tail -2 | head -1)"
            echo "Memory: $(wmic computersystem get TotalPhysicalMemory 2>/dev/null | tail -2 | awk '{print int($1/1024/1024/1024) " GB"}')"
            ;;
    esac
}

# Docker helpers (cross-platform)
docker_clean() {
    echo "Cleaning Docker system..."
    docker system prune -a --volumes -f
    docker network prune -f
    echo "Docker cleanup complete"
}

# Git helpers (cross-platform)
git_clean_branches() {
    echo "Cleaning merged branches..."
    git branch --merged | grep -v "\*\|main\|master\|develop" | xargs -n 1 git branch -d 2>/dev/null
    echo "Branch cleanup complete"
}

# Archive extraction (unified)
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xvjf "$1"    ;;
            *.tar.gz)    tar xvzf "$1"    ;;
            *.tar.xz)    tar xvJf "$1"    ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       
                if command -v unrar >/dev/null 2>&1; then
                    unrar x "$1"
                elif command -v rar >/dev/null 2>&1; then
                    rar x "$1"
                else
                    echo "Please install unrar or rar"
                    return 1
                fi
                ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xvf "$1"     ;;
            *.tbz2)      tar xvjf "$1"    ;;
            *.tgz)       tar xvzf "$1"    ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        
                if [ "$PLATFORM" = "Mac" ]; then
                    7za x "$1"
                else
                    7z x "$1"
                fi
                ;;
            *)           echo "don't know how to extract '$1'..." ;;
        esac
    else
        echo "'$1' is not a valid file!"
    fi
}

# Archive creation (unified)
compress() {
    local name="${1%%/}"
    shift
    local format="${1:-tgz}"
    
    case "$format" in
        tar)    tar cvf "${name}.tar" "${name}/"     ;;
        tgz)    tar cvzf "${name}.tar.gz" "${name}/" ;;
        tbz)    tar cvjf "${name}.tar.bz2" "${name}/";;
        zip)    zip -r "${name}.zip" "${name}/"      ;;
        7z)     
            if [ "$PLATFORM" = "Mac" ]; then
                7za a "${name}.7z" "${name}/"
            else
                7z a "${name}.7z" "${name}/"
            fi
            ;;
        *)      echo "Unknown format: $format" ;;
    esac
}

# Clipboard operations (unified)
copy_to_clipboard() {
    case "$PLATFORM" in
        Mac)
            pbcopy
            ;;
        WSL)
            # WSL -> Windows clipboard
            clip.exe 2>/dev/null || powershell.exe -command '$input | Set-Clipboard' 2>/dev/null || cat
            ;;
        Linux)
            if command -v xclip >/dev/null 2>&1; then
                xclip -selection clipboard
            elif command -v xsel >/dev/null 2>&1; then
                xsel --clipboard --input
            else
                echo "Please install xclip or xsel"
                return 1
            fi
            ;;
        Git|Cygwin)
            clip 2>/dev/null || powershell.exe -command '$input | Set-Clipboard' 2>/dev/null || cat
            ;;
    esac
}

paste_from_clipboard() {
    case "$PLATFORM" in
        Mac)
            pbpaste
            ;;
        WSL)
            # Prefer Windows clipboard from WSL
            powershell.exe -command 'Get-Clipboard' 2>/dev/null || clip.exe 2>/dev/null || cat
            ;;
        Linux)
            if command -v xclip >/dev/null 2>&1; then
                xclip -selection clipboard -o
            elif command -v xsel >/dev/null 2>&1; then
                xsel --clipboard --output
            else
                echo "Please install xclip or xsel"
                return 1
            fi
            ;;
        Git|Cygwin)
            powershell.exe -command 'Get-Clipboard' 2>/dev/null || clip 2>/dev/null || cat
            ;;
    esac
}

# Open file/URL with default application
open_file() {
    local target="${1:-.}"
    local win_target
    win_target=$(_to_windows_path "$target")

    case "$PLATFORM" in
        Mac)
            open "$target"
            ;;
        Linux)
            xdg-open "$target"
            ;;
        WSL|Git|Cygwin)
            # Windows Explorer via converted native path (handles ../.., relative paths, /c/..., etc.)
            if command -v explorer.exe >/dev/null 2>&1; then
                explorer.exe "$win_target"
            elif [ -x "/c/Windows/explorer.exe" ]; then
                "/c/Windows/explorer.exe" "$win_target"
            else
                start "$win_target" 2>/dev/null || cmd //c start "$win_target" 2>/dev/null || echo "Could not open $target"
            fi
            ;;
        *)
            # Fallback for unknown
            explorer.exe "$win_target" 2>/dev/null || xdg-open "$target" 2>/dev/null || open "$target" 2>/dev/null || echo "open_file: unsupported on $PLATFORM"
            ;;
    esac
}

# Sound/notification utilities
notify() {
    local title="${1:-Notification}"
    local message="${2:-Task completed}"
    
    case "$PLATFORM" in
        Mac)
            osascript -e "display notification \"$message\" with title \"$title\""
            ;;
        Linux)
            if command -v notify-send >/dev/null 2>&1; then
                notify-send "$title" "$message"
            else
                echo "[$title] $message"
            fi
            ;;
        Git|Cygwin|WSL)
            powershell.exe -command "New-BurntToastNotification -Text '$title','$message' -ErrorAction SilentlyContinue" 2>/dev/null || \
            powershell.exe -command "Write-Host '[$title] $message'" 2>/dev/null || echo "[$title] $message"
            ;;
    esac
}

beep() {
    case "$PLATFORM" in
        Mac)
            say "beep" || afplay /System/Library/Sounds/Ping.aiff
            ;;
        Linux)
            if command -v paplay >/dev/null 2>&1; then
                paplay /usr/share/sounds/freedesktop/stereo/complete.oga
            elif command -v speaker-test >/dev/null 2>&1; then
                speaker-test -t sine -f 1000 -l 1 &
                sleep 0.2
                killall speaker-test 2>/dev/null
            else
                echo -e "\a"
            fi
            ;;
        Git|Cygwin|WSL)
            powershell.exe -c "[console]::beep(1000,300)" 2>/dev/null || echo -e "\a"
            ;;
    esac
}

# Performance monitoring
top_cmd() {
    case "$PLATFORM" in
        Mac)
            if command -v htop >/dev/null 2>&1; then
                htop
            else
                top -o cpu
            fi
            ;;
        Linux)
            if command -v htop >/dev/null 2>&1; then
                htop
            elif command -v btop >/dev/null 2>&1; then
                btop
            else
                top
            fi
            ;;
        Git|Cygwin|WSL)
            taskmgr || powershell.exe -command "Start-Process taskmgr"
            ;;
    esac
}

# Disk usage
disk_usage() {
    case "$PLATFORM" in
        Mac|Linux)
            if command -v ncdu >/dev/null 2>&1; then
                ncdu "${1:-.}"
            else
                du -sh "${1:-.}"/* | sort -h
            fi
            ;;
        Git|Cygwin|WSL)
            powershell.exe -command "Get-ChildItem '${1:-.}' | Sort-Object Length -Descending | Select-Object Name, @{Name='Size';Expression={'{0:N2} MB' -f ($_.Length / 1MB)}}" 2>/dev/null || du -sh "${1:-.}"/*
            ;;
    esac
}

# Memory info
mem_info() {
    case "$PLATFORM" in
        Mac)
            vm_stat | perl -ne '/page size of (\d+)/ and $size=$1; /Pages\s+([^:]+)[^\d]+(\d+)/ and printf("%-16s % 16.2f MB\n", "$1:", $2 * $size / 1048576);'
            ;;
        Linux)
            free -h
            ;;
        Git|Cygwin|WSL)
            wmic OS get TotalVisibleMemorySize,FreePhysicalMemory 2>/dev/null || \
            powershell.exe -command "Get-CimInstance Win32_OperatingSystem | Select-Object TotalVisibleMemorySize, FreePhysicalMemory"
            ;;
    esac
}

# Swap/memory reset (cross-platform)
reswap() {
    case "$PLATFORM" in
        Mac)
            echo "Purging disk cache and reclaiming memory..."
            sudo_run purge
            echo "Memory purge complete. macOS manages swap automatically."
            vm_stat | head -8
            ;;
        Linux)
            if command -v swapoff >/dev/null 2>&1; then
                echo "Resetting swap..."
                if sudo_run swapoff -a && sudo_run swapon -a; then
                    echo "Swap reset complete."
                    free -h | grep -i swap
                else
                    echo "Swap reset failed. Re-run from an interactive shell or set SUDO_PW in ~/.secretbashrc." >&2
                    return 1
                fi
            else
                echo "swapoff not available. Try: sudo sysctl vm.drop_caches=3"
            fi
            ;;
        Git|Cygwin|WSL)
            echo "Clearing standby memory / recycle bin..."
            powershell.exe -command "Clear-RecycleBin -Force -ErrorAction SilentlyContinue; [System.GC]::Collect()" 2>/dev/null || true
            echo "Note: Windows swap (pagefile) reset requires a reboot or:"
            echo "  1. Control Panel > System > Advanced > Performance > Virtual Memory"
            echo "  2. Set to 'No paging file', reboot, then re-enable"
            ;;
        *)
            echo "Unsupported platform: $PLATFORM"
            return 1
            ;;
    esac
}

# Create aliases for common operations
alias pkg-install='pkg_install'
alias pkg-update='pkg_update'
alias svc-start='service_start'
alias svc-stop='service_stop'
alias svc-status='service_status'
alias killport='kill_port'
alias findproc='find_process'
alias myip='get_local_ip'
alias publicip='curl -s ifconfig.me'
alias trash='trash_file'
alias sysinfo='sys_info'
alias docker-clean='docker_clean'
alias git-clean='git_clean_branches'
alias clip='copy_to_clipboard'
alias paste='paste_from_clipboard'
# Note: PLATFORM may be WSL/Git now; aliases still work via the funcs above
alias o='open_file'
alias oo='open_file'
alias alert='notify "Alert" "Command completed"'
alias meminfo='mem_info'
alias duh='disk_usage'
alias topc='top_cmd'

# Export platform for use in other scripts
export PLATFORM

# ------------------------------------------------------------------
# Git Bash / MSYS convenience: make the raw "explorer" command do the
# right thing with Unix paths (../.., relative dirs, /c/Users/..., etc.)
# This is why `explorer ../..` now works properly from Git Bash.
# (WSL users usually have their own explorer alias in wslbashrc.)
# ------------------------------------------------------------------
if [ "$PLATFORM" = "Git" ] || [ "$PLATFORM" = "Cygwin" ]; then
    explorer() {
        local target="${1:-.}"
        local wp
        wp="$(_to_windows_path "$target")"
        if command -v explorer.exe >/dev/null 2>&1; then
            explorer.exe "$wp"
        elif [ -x "/c/Windows/explorer.exe" ]; then
            "/c/Windows/explorer.exe" "$wp"
        else
            command explorer "$wp" 2>/dev/null || start "$wp" 2>/dev/null || echo "explorer: could not launch for $target"
        fi
    }
    # Also expose the converter for advanced users/scripts
    export -f _to_windows_path 2>/dev/null || true
fi

