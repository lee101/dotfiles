def gpu_class(name, cc):
    n = name.upper()
    if cc == "90" or "H100" in n or "H200" in n:
        return "hopper"
    if cc == "100" or "B200" in n or "GB200" in n:
        return "blackwell-dc"
    if cc == "120" or "5090" in n or "5080" in n:
        return "blackwell"
    if cc == "89" or "4090" in n or "4080" in n or "L40" in n:
        return "ada"
    if cc == "80" or "A100" in n:
        return "ampere-dc"
    if cc in ("86", "87") or "3090" in n or "A40" in n or "A10" in n:
        return "ampere"
    if cc == "75" or "T4" in n or "2080" in n:
        return "turing"
    return "ampere"


def out(obj, compact=True):
    print(json.dumps(obj, separators=(",", ":") if compact else None, sort_keys=True))


def sh(cmd, check=False, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if check and r.returncode:
        sys.exit(f"{cmd[0]} failed:\n{r.stderr[-800:]}")
    return r


def smi(fields):
    r = sh(["nvidia-smi", f"--query-gpu={fields}", "--format=csv,noheader,nounits"])
    return [x.strip() for x in r.stdout.strip().splitlines()[0].split(",")] if r.stdout.strip() else []


def num(s):
    m = re.fullmatch(r"\s*([\d.]+)\s*([kKmMgGtT]?)i?[bB]?\s*", str(s))
    if not m:
        sys.exit(f"bad number {s}")
    return float(m[1]) * {"": 1, "k": 1e3, "m": 1e6, "g": 1e9, "t": 1e12}[m[2].lower()]


def demangle(names):
    if not names or not shutil.which("c++filt"):
        return names
    r = sh(["c++filt"], input="\n".join(names))
    out = r.stdout.splitlines()
    return out if len(out) == len(names) else names


def short(n, w=48):
    n = re.sub(r"\(.*", "", n) if n.count("(") and not n.startswith("(") else n
    n = re.sub(r"^void\s+", "", n)
    n = re.sub(r"\b(at::native::|cutlass::|cub::|at::|std::)", "", n)
    return n if len(n) <= w else n[: w - 1] + "~"


def table(rows, hdr, right=()):
    w = [max(len(str(x[i])) for x in [hdr] + rows) for i in range(len(hdr))]
    for r in [hdr] + rows:
        print(" ".join(str(c).rjust(w[i]) if i in right else str(c).ljust(w[i]) for i, c in enumerate(r)).rstrip())


def spec():
    p = CACHE / "spec.json"
    if p.exists():
        return json.loads(p.read_text())
    return None


def cmd_doctor(a):
    f = smi("name,compute_cap,memory.used,memory.total,utilization.gpu,clocks.sm,clocks.max.sm,power.draw,power.limit,temperature.gpu,clocks_throttle_reasons.active")
    if not f:
        sys.exit("no nvidia-smi")
    name, cc, mu, mt, ut, ck, cm, pw, pl, tp, thr = f
    cc = cc.replace(".", "")
    r = sh(["nvidia-smi", "--query-compute-apps=pid,used_memory,process_name", "--format=csv,noheader,nounits"])
    procs = []
    for p in r.stdout.strip().splitlines():
        if p.strip():
            pid, mem, exe = [x.strip() for x in p.split(",", 2)]
            procs.append(dict(pid=int(pid), mem_mb=int(float(mem)), exe=exe[:120]))
    bits = {0x2: "app-clk", 0x4: "sw-power", 0x8: "hw-slowdown", 0x20: "sw-thermal", 0x40: "hw-thermal", 0x80: "hw-power-brake"}
    try:
        tv = int(thr, 16)
    except ValueError:
        tv = 0
    act = [n for b, n in bits.items() if tv & b]
    issues = []
    if int(ut) > 15 and (not procs or any("chrome" not in x["exe"] for x in procs)):
        issues.append(f"NOISY: gpu {ut}% busy before we start; timings inflated/unstable (check procs)")
    if int(mt) - int(mu) < 3000:
        issues.append(f"LOWMEM: {int(mt) - int(mu)}MiB free")
    if float(pw) > 0.95 * float(pl):
        issues.append("POWER: at power limit, clocks will sag")
    if int(ck) < 0.85 * int(cm) and int(ut) > 50:
        issues.append(f"CLOCKS: sm {ck} < 85% of max {cm}")
    prm = Path("/proc/driver/nvidia/params")
    restricted = bool(prm.exists() and re.search(r"RmProfilingAdminOnly:\s*1", prm.read_text()))
    if restricted:
        issues.append("NCU: counters restricted (ERR_NVGPUCTRPERM). fix: echo 'options nvidia NVreg_RestrictProfilingToAdminUsers=0' | sudo tee /etc/modprobe.d/nvidia-prof.conf; reboot (or unload nvidia mods). cuk trace/res/bw/roof work without it")
    ch = os.environ.get("CUDA_HOME")
    if ch and not Path(ch, "bin/nvcc").exists():
        issues.append(f"CUDA_HOME={ch} has no bin/nvcc -> torch ext builds fail; export CUDA_HOME={Path(shutil.which('nvcc') or '/usr/local/cuda').parent.parent}")
    tools = {t: bool(shutil.which(t)) for t in ("nvcc", "nsys", "ncu", "cuobjdump", "nvdisasm", "c++filt")}
    miss = [t for t, ok in tools.items() if not ok]
    if miss:
        issues.append("missing: " + " ".join(miss))
    cls = gpu_class(name, cc)
    prof = PROFILES.get(cls, PROFILES["ampere"])
    obj = dict(gpu=name, cc=cc, class_=cls, mem_used_mb=int(mu), mem_total_mb=int(mt),
               util_pct=int(ut), clock_sm=int(ck), clock_max=int(cm), power_w=float(pw),
               power_limit_w=float(pl), temp_c=int(tp), throttle=act, procs=procs,
               profile=dict(batch=prof["batch"], ubatch=prof["ubatch"], kv=prof["kv"],
                            flash=prof["flash"], contexts=prof["ctx"]),
               ncu_restricted=restricted, tools=tools, issues=issues)
    if a.json:
        out(obj)
        return
    print(f"{name} sm{cc} mem {mu}/{mt}MiB util {ut}% sm {ck}/{cm}MHz pwr {pw}/{pl}W {tp}C throttle {thr}")
    for p in procs:
        print(f"  pid {p['pid']} {p['mem_mb']}MiB {p['exe'].split()[0] if p['exe'].startswith('/') else p['exe']}"[:150])
    if act:
        print("  throttling:", ",".join(act))
    print(f"  profile {cls} batch {prof['batch']}/{prof['ubatch']} kv {prof['kv']} fa {'on' if prof['flash'] else 'off'} ctx {prof['ctx']}")
    print("\n".join(issues) if issues else "ok: gpu idle, counters accessible")


def build_bw():
    cc = smi("compute_cap")[0].replace(".", "")
    d = CACHE / f"sm{cc}"
    d.mkdir(parents=True, exist_ok=True)
    exe = d / "bw"
    src = HERE / "bw.cu"
    if not exe.exists() or exe.stat().st_mtime < src.stat().st_mtime:
        sh(["nvcc", "-O3", f"-arch=sm_{cc}", "-Wno-deprecated-gpu-targets", "-o", str(exe), str(src)], check=True)
    return exe


def measure_spec(reps):
    exe = build_bw()
    best = None
    for _ in range(max(1, reps)):
        d = json.loads(sh([str(exe)], check=True).stdout)
        if best is None:
            best = d
        else:
            for k in ("rd_gbs", "copy_gbs", "l2_gbs", "fp32_tflops", "bf16_mma_tflops"):
                best[k] = max(best[k], d.get(k, 0))
            for k in ("launch_us", "graph_node_us"):
                best[k] = min(best[k], d[k])
    best["util_at_measure"] = int(smi("utilization.gpu")[0])
    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / "spec.json").write_text(json.dumps(best))
    return best


def cmd_bw(a):
    p = CACHE / "spec.json"
    d = json.loads(p.read_text()) if p.exists() and not a.force else None
    if not d or "l2_gbs" not in d:
        d = measure_spec(a.reps)
    if a.json:
        out(d)
        return
    pct = 100 * d["rd_gbs"] / d["spec_gbs"] if d["spec_gbs"] else 0
    print(f"{d['name']} sm{d['sm']} {d['sms']}SM L2 {d['l2_mb']}MB smem/SM {d['smem_per_sm_kb']}KB")
    print(f"dram rd {d['rd_gbs']:.0f}GB/s ({pct:.0f}% spec) copy {d['copy_gbs']:.0f}GB/s L2 {d.get('l2_gbs', 0):.0f}GB/s")
    print(f"fp32 {d['fp32_tflops']:.1f}TF bf16-mma {d['bf16_mma_tflops']:.1f}TF launch {d['launch_us']:.2f}us node {d['graph_node_us']:.2f}us")
    if int(d.get("util_at_measure", 0)) > 15:
        print(f"WARN: gpu {d['util_at_measure']}% busy by others; peaks are lower bounds. rerun: cuk bw --force")


def cmd_roof(a):
    d = spec()
    if not d or "l2_gbs" not in d:
        d = measure_spec(3)
    by = (num(a.bytes) if a.bytes else 0) + (num(a.gb) * 1e9 if a.gb else 0)
    fl = num(a.flops) if a.flops else 0
    tf = d["bf16_mma_tflops"] if a.tc else d["fp32_tflops"]
    bw = d.get("l2_gbs" if a.l2 else "rd_gbs") or d["rd_gbs"]
    t_mem = by / (bw * 1e9) * 1e6
    t_cmp = fl / (tf * 1e12) * 1e6
    floor = max(t_mem, t_cmp, d["graph_node_us"])
    bound = "launch" if floor == d["graph_node_us"] else "mem" if t_mem >= t_cmp else "compute"
    o = dict(floor_us=floor, bound=bound, mem_us=t_mem, math_us=t_cmp, node_us=d["graph_node_us"],
             bw_gbs=bw, tf=tf, intensity=(fl / by if by else None),
             ridge=(tf * 1e12 / (bw * 1e9) if by else None), l2=bool(a.l2))
    if a.us:
        t = float(a.us)
        o.update(actual_us=t, pct_floor=100 * floor / t, off=t / floor)
        if by: o["achieved_gbs"] = by / t / 1e3
        if fl: o["achieved_tf"] = fl / t / 1e6
    if a.json:
        out(o)
        return
    print(f"floor {floor:.1f}us ({bound}) mem {t_mem:.1f}us @{bw:.0f}GB/s  math {t_cmp:.1f}us @{tf:.0f}TF  node {d['graph_node_us']:.1f}us")
    if by and fl:
        print(f"intensity {fl / by:.1f} flop/B  ridge {tf * 1e12 / (bw * 1e9):.0f} flop/B")
    if a.us:
        print(f"actual {o['actual_us']:.1f}us = {o['pct_floor']:.0f}% of floor ({o['off']:.1f}x off)")
        if o["actual_us"] < floor * 0.97:
            print(f"IMPOSSIBLE: faster than floor -> bytes/flops overcounted, or data L2-resident (L2 {d['l2_mb']:.0f}MB)")
        if by:
            print(f"achieved {o['achieved_gbs']:.0f}GB/s = {100 * o['achieved_gbs'] / bw:.0f}% of {('L2' if a.l2 else 'dram')} peak")
        if fl:
            print(f"achieved {o['achieved_tf']:.2f}TF = {100 * o['achieved_tf'] / tf:.0f}% of peak")


def resource_usage(path):
    r = sh(["cuobjdump", "--dump-resource-usage", str(path)])
    out, cur_arch = [], None
    lines = r.stdout.splitlines()
    i = 0
    while i < len(lines):
        l = lines[i]
        if re.match(r"\s*Function (\S+):", l):
            fn = re.match(r"\s*Function (\S+):", l)[1]
            nxt = lines[i + 1] if i + 1 < len(lines) else ""
            kv = dict(re.findall(r"(\w+)\s*[:=]\s*(\d+)", nxt))
            out.append((fn, {k: int(v) for k, v in kv.items()}))
        i += 1
    return out


def occupancy(regs, smem, block, cc, dyn_smem=0):
    L = SM_LIMITS.get(cc) or SM_LIMITS["86"]
    wpb = -(-block // 32)
    alloc_regs = -(-regs // 8) * 8 * 32
    by_regs = L["regs"] // (alloc_regs * wpb) if regs else L["blk"]
    smem = max(0, smem) + max(0, dyn_smem)
    cap = min(L["smem_kb"], L.get("smem_blk_kb", L["smem_kb"])) * 1024
    by_smem = cap // (smem + 1024) if smem else L["blk"]
    by_thr = L["thr"] // block
    lim = {"regs": by_regs, "smem": by_smem, "threads": by_thr, "blocks": L["blk"]}
    blk = max(0, min(lim.values()))
    why = min(lim, key=lim.get)
    return blk, 100 * blk * wpb / L["warps"], why, dict(lim, warps=L["warps"], wpb=wpb)


def cmd_res(a):
    cc = (a.cc or (smi("compute_cap") or ["8.6"])[0]).replace(".", "")
    p = Path(a.path)
    if p.is_dir():
        c = sorted([x for x in p.rglob("*") if x.suffix in (".so", ".o", ".cubin") or x.name.endswith(".a")], key=lambda x: x.stat().st_mtime, reverse=True)
        if not c:
            sys.exit("no .so/.o/.cubin")
        p = c[0]
        if not a.json:
            print(f"using {p}")
    if p.suffix in (".cu",):
        tmp = Path(tempfile.mkdtemp()) / "k.cubin"
        sh(["nvcc", "-O3", "-cubin", f"-arch=sm_{cc}", "-o", str(tmp), str(p)] + a.nvcc, check=True)
        p = tmp
    rows, recs = [], []
    fs = resource_usage(p)
    names = demangle([f for f, _ in fs])
    for (f, u), n in zip(fs, names):
        if a.filter and not re.search(a.filter, n):
            continue
        regs, sm_, loc = u.get("REG", 0), u.get("SHARED", 0), u.get("LOCAL", 0)
        stack = u.get("STACK", 0)
        blk, occ, why, lim = occupancy(regs, sm_, a.block, cc, a.dyn_smem)
        flags = []
        if loc or stack:
            flags.append(f"SPILL/STACK local={loc} stack={stack}")
        if blk == 0:
            flags.append(f"CANNOT LAUNCH at block={a.block} ({why})")
        elif occ < 50:
            flags.append(f"lowocc<-{why}")
        recs.append(dict(kernel=n, regs=regs, smem=sm_, lmem=loc, stack=stack,
                         blocks=blk, occ_pct=round(occ, 1), limit=why,
                         limits=lim, flags=flags))
        rows.append([short(n, 44), regs, sm_, loc, f"{blk}", f"{occ:.0f}%", why, " ".join(flags)])
    if a.json:
        out(dict(cc=cc, block=a.block, dyn_smem=a.dyn_smem, kernels=recs))
        return
    table(rows, ["kernel", "reg", "smem", "lmem", "blk/SM", "occ", "limit", "flags"], right=(1, 2, 3, 4, 5))
    print(f"occupancy assumes block={a.block}, static smem + dyn={a.dyn_smem}, +1KB/blk reserved")


def child_env():
    e = dict(os.environ)
    v = e.pop("VIRTUAL_ENV", None)
    if v:
        e["PATH"] = os.pathsep.join(x for x in e["PATH"].split(os.pathsep) if not x.startswith(v))
    return e


def nsys_profile(cmd, prefix, args):
    base = ["nsys", "profile", "-o", str(prefix), "-f", "true", "--trace=cuda,nvtx", "--sample=none", "--cpuctxsw=none", "--cuda-graph-trace=node", "--stats=false"]
    if args.delay:
        base += [f"--delay={args.delay}"]
    r = subprocess.run(base + cmd, capture_output=True, text=True, timeout=args.timeout, env=child_env())
    rep = Path(str(prefix) + ".nsys-rep")
    if not rep.exists():
        sys.exit("nsys failed:\n" + (r.stdout + r.stderr)[-1000:])
    return rep, r


def cmd_trace(a):
    cmd = a.cmd[1:] if a.cmd and a.cmd[0] == "--" else a.cmd
    if not cmd and not a.rep:
        sys.exit("usage: cuk trace [opts] -- cmd")
    tmpd = Path(tempfile.mkdtemp())
    if a.rep:
        rep = Path(a.rep)
    else:
        rep, r = nsys_profile(cmd, tmpd / "t", a)
        if r.returncode:
            print(f"cmd exit {r.returncode}: {(r.stderr or r.stdout)[-300:].strip()}")
    sq = rep.with_suffix(".sqlite") if a.rep else tmpd / "t.sqlite"
    if not sq.exists() or a.rep and sq.stat().st_mtime < rep.stat().st_mtime:
        sh(["nsys", "export", "--type=sqlite", "-o", str(sq), "-f", "true", str(rep)], check=True)
    db = sqlite3.connect(sq)
    cols = {r[1] for r in db.execute("pragma table_info(CUPTI_ACTIVITY_KIND_KERNEL)")}
    if not cols:
        sys.exit("no kernels traced")
    nm = "demangledName" if "demangledName" in cols else "shortName"
    q = f"""select k.start,k.end,s.value,k.gridX*k.gridY*k.gridZ,k.blockX*k.blockY*k.blockZ,k.registersPerThread,
            k.staticSharedMemory+k.dynamicSharedMemory,k.streamId from CUPTI_ACTIVITY_KIND_KERNEL k join StringIds s on s.id=k.{nm} order by k.start"""
    ks = db.execute(q).fetchall()
    if a.skip:
        t0 = ks[0][0] + a.skip * (ks[-1][1] - ks[0][0])
        ks = [k for k in ks if k[0] >= t0]
    if a.exclude:
        ks = [k for k in ks if not re.search(a.exclude, k[2])]
    if a.filter:
        ks = [k for k in ks if re.search(a.filter, k[2])]
    if not ks:
        sys.exit("no kernels after filters")
    busy, cur_s, cur_e = 0, ks[0][0], ks[0][1]
    gaps, big = [], 0
    gmax = a.gapmax * 1e3
    for k in ks[1:]:
        if k[0] > cur_e:
            busy += cur_e - cur_s
            if k[0] - cur_e > gmax:
                big += 1
            else:
                gaps.append(k[0] - cur_e)
            cur_s, cur_e = k[0], k[1]
        else:
            cur_e = max(cur_e, k[1])
    busy += cur_e - cur_s
    wall = busy + sum(gaps)
    sum_dur = sum(k[1] - k[0] for k in ks)
    agg = {}
    for k in ks:
        g = agg.setdefault((k[2], k[3], k[4]), dict(n=0, t=0, mn=1e18, mx=0, ds=[], grid=k[3], blk=k[4], reg=k[5], sm=k[6]))
        d = k[1] - k[0]
        g["n"] += 1
        g["t"] += d
        g["ds"].append(d)
        g["mn"] = min(g["mn"], d)
        g["mx"] = max(g["mx"], d)
    order = sorted(agg.items(), key=lambda x: -x[1]["t"])[: a.top]
    dn = demangle([n[0] for n, _ in order])
    rows, recs = [], []
    for (n, g), dm in zip(order, dn):
        rows.append([short(dm, 40), g["n"], f"{g['t'] / 1e3:.1f}", f"{st.median(g['ds']) / 1e3:.2f}", f"{g['mn'] / 1e3:.2f}", f"{g['mx'] / 1e3:.2f}", f"{100 * g['t'] / sum_dur:.0f}%", g["grid"], g["blk"], g["reg"], g["sm"]])
        recs.append(dict(kernel=dm, n=g["n"], tot_us=round(g["t"] / 1e3, 2),
                         p50_us=round(st.median(g["ds"]) / 1e3, 2), min_us=round(g["mn"] / 1e3, 2),
                         max_us=round(g["mx"] / 1e3, 2), share_pct=round(100 * g["t"] / sum_dur, 1),
                         grid=g["grid"], block=g["blk"], regs=g["reg"], smem=g["sm"]))
    tiny = sum(1 for k in ks if k[1] - k[0] < 5000)
    v = []
    if busy / wall < 0.7 and not (a.filter or a.exclude):
        v.append(f"GPU idle {100 - 100 * busy / wall:.0f}% of span -> launch/host-bound or syncs; use CUDA graphs/fuse")
    if (a.filter or a.exclude) and busy / wall < 0.7:
        v.append("idle%/gaps cover filtered-out kernels too; judge by p50/min only")
    if tiny > 0.3 * len(ks):
        v.append(f"{tiny}/{len(ks)} kernels <5us -> launch-bound; fuse")
    top = order[0][1]
    for n, g in order[:3]:
        if g["n"] >= 5 and st.median(g["ds"]) > 2 * g["mn"] and g["mn"] > 5000:
            v.append(f"{short(n[0], 24)} p50 {st.median(g['ds']) / 1e3:.0f}us vs min {g['mn'] / 1e3:.0f}us -> unstable: GPU shared/throttled (cuk doctor) or sync spin; compare min")
    if top["t"] / sum_dur > 0.6:
        v.append(f"one kernel is {100 * top['t'] / sum_dur:.0f}% of GPU time -> optimize it (cuk res / cuk ncu)")
    if sum_dur / busy > 1.2:
        v.append("streams overlap")
    mem = db.execute("select count(*),sum(end-start),sum(bytes) from CUPTI_ACTIVITY_KIND_MEMCPY").fetchone() if db.execute("select name from sqlite_master where name='CUPTI_ACTIVITY_KIND_MEMCPY'").fetchone() else None
    summary = dict(launches=len(ks), unique=len(agg), span_us=round(wall / 1e3, 1),
                   busy_pct=round(100 * busy / wall, 0), kernel_sum_us=round(sum_dur / 1e3, 1),
                   overlap=round(sum_dur / busy, 2),
                   gaps=dict(n=len(gaps), med_us=round(st.median(gaps) / 1e3, 2),
                             p90_us=round(sorted(gaps)[int(0.9 * len(gaps))] / 1e3, 2),
                             total_us=round(sum(gaps) / 1e3, 1)) if gaps else None,
                   ignored_big_gaps=big, tiny=dict(n=tiny, total=len(ks)),
                   memcpy=dict(n=mem[0], us=round(mem[1] / 1e3, 1), mb=round(mem[2] / 1e6, 1)) if mem and mem[0] else None,
                   verdicts=v)
    if a.json:
        out(dict(summary=summary, kernels=recs))
        return
    table(rows, ["kernel", "n", "tot_us", "p50", "min", "max", "share", "grid", "blk", "reg", "smem"], right=range(1, 11))
    if big:
        print(f"ignored {big} idle gaps >{a.gapmax}ms (host phases: load/compile/sync/between iters)")
    print(f"{len(ks)} launches {len(agg)} unique | span {wall / 1e3:.1f}us busy {100 * busy / wall:.0f}% | kernel-sum {sum_dur / 1e3:.1f}us (overlap x{sum_dur / busy:.2f})")
    if gaps:
        print(f"gaps: n={len(gaps)} med {st.median(gaps) / 1e3:.2f}us p90 {sorted(gaps)[int(0.9 * len(gaps))] / 1e3:.2f}us total {sum(gaps) / 1e3:.1f}us ({100 * sum(gaps) / wall:.0f}% of span)")
    print("verdict: " + ("; ".join(v) if v else "balanced, no obvious structural issue"))
    if mem and mem[0]:
        print(f"memcpy: {mem[0]} {mem[1] / 1e3:.1f}us {mem[2] / 1e6:.1f}MB")


