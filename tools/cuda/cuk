def _index(rows):
    if isinstance(rows, dict) and "kernels" in rows:
        rows = rows["kernels"]
    if isinstance(rows, list):
        outd = {}
        for r in rows:
            if not isinstance(r, dict):
                return None
            k = r.get("kernel") or r.get("name")
            if not k:
                return None
            if r.get("arch"):
                k = f"{r['arch']}:{k}"
            outd[k] = r
        return outd
    return None


def cmd_diff(a):
    A, B = json.loads(Path(a.a).read_text()), json.loads(Path(a.b).read_text())
    ia, ib = _index(A), _index(B)
    res = []
    if ia is not None and ib is not None:
        for k in sorted(set(ia) | set(ib)):
            if k not in ia or k not in ib:
                res.append(dict(key=k, base=None, new=None, delta=None))
                continue
            for f in ("sass", "regs", "tot_us", "p50_us", "occ_pct", "floor_us", "rd_gbs", "copy_gbs", "l2_gbs", "fp32_tflops", "bf16_mma_tflops"):
                if f in ia[k] or f in ib[k]:
                    x, y = ia[k].get(f), ib[k].get(f)
                    d = (None if x in (None, 0) or y is None else 100 * (y - x) / abs(x))
                    res.append(dict(key=k, field=f, base=x, new=y, delta_pct=d))
        if not res:
            sys.exit("no comparable numeric fields")
        res.sort(key=lambda r: -abs(r["delta_pct"] or 0))
        if a.json:
            out(res)
            return
        for r in res:
            if r["delta_pct"] is None:
                if a.all:
                    print(f"{short(r['key'], 46):46} {r['field']:14} {'-':>10} -> {str(r['new']):>10}    new")
                continue
            if abs(r["delta_pct"]) < a.threshold and not a.all:
                continue
            print(f"{short(r['key'], 46):46} {r['field']:14} {str(r['base']):>10} -> {str(r['new']):>10} {r['delta_pct']:+7.1f}%")
        return
    if isinstance(A, dict) and isinstance(B, dict):
        for k in sorted(set(A) | set(B)):
            x, y = A.get(k), B.get(k)
            if isinstance(x, (int, float)) and isinstance(y, (int, float)):
                d = 100 * (y - x) / abs(x) if x else None
                res.append(dict(key=k, field=k, base=x, new=y, delta_pct=d))
        if a.json:
            out(res)
            return
        for r in sorted(res, key=lambda r: -abs(r["delta_pct"] or 0)):
            if r["delta_pct"] is None:
                if a.all:
                    print(f"{r['key']:28} {'-':>12} -> {str(r['new']):>12}    new")
                continue
            if abs(r["delta_pct"]) < a.threshold and not a.all:
                continue
            print(f"{r['key']:28} {str(r['base']):>12} -> {str(r['new']):>12} {r['delta_pct']:+7.1f}%")
        return
    sys.exit("diff needs two JSON files from trace/bw/roof/res/sass")


