def classify(m):
    dur = m.get("dur", 0)
    sm, dram, mem = m.get("sm", 0), m.get("dram", 0), m.get("mem", 0)
    if dur and dur < 8:
        return "launch-bound (tiny)"
    if dram >= 70 and dram >= sm:
        return "DRAM-bw bound"
    if sm >= 70 and sm >= mem:
        return "SM/issue bound"
    if m.get("l2", 0) >= 70 or m.get("l1", 0) >= 80:
        return "cache/LSU bound"
    if max(sm, mem, m.get("l1", 0), m.get("l2", 0)) < 60:
        return "latency-bound (stalls/occupancy/tail)"
    return "mixed"


def cmd_ncu(a):
    cmd = a.cmd[1:] if a.cmd and a.cmd[0] == "--" else a.cmd
    if not cmd:
        sys.exit("usage: cuk ncu -k REGEX [-n N] [--skip S] -- cmd")
    tmpd = Path(tempfile.mkdtemp())
    args = ["ncu", "--csv", "--page", "details"]
    if a.full:
        args += ["--set", "full"]
    else:
        args += ["--section", "SpeedOfLight", "--section", "Occupancy", "--section", "LaunchStats",
                 "--section", "WarpStateStats", "--section", "MemoryWorkloadAnalysis", "--section", "SchedulerStats"]
    if a.stalls:
        args += ["--metrics", r"regex:smsp__average_warps_issue_stalled_.*_per_issue_active\.ratio"]
    if a.metrics:
        args += ["--metrics", a.metrics]
    if a.k:
        args += ["-k", f"regex:{a.k}"]
    args += ["-c", str(a.n), "-s", str(a.skip)]
    r = subprocess.run(args + cmd, capture_output=True, text=True, timeout=a.timeout, env=child_env())
    if "ERR_NVGPUCTRPERM" in r.stdout + r.stderr:
        sys.exit("ncu: counters restricted. run `cuk doctor` for the fix. counter-free alternatives: cuk trace, cuk res, cuk roof")
    lines = r.stdout.splitlines()
    start = next((i for i, l in enumerate(lines) if l.startswith('"ID"')), None)
    if start is None:
        sys.exit("ncu: no data\n" + (r.stdout + r.stderr)[-800:])
    rd = csv.DictReader(io.StringIO("\n".join(lines[start:])))
    kers = {}
    for row in rd:
        key = (row["ID"], row["Kernel Name"])
        d = kers.setdefault(key, {})
        name, unit, val = row["Metric Name"], row["Metric Unit"], row["Metric Value"].replace(",", "")
        try:
            v = float(val)
        except ValueError:
            continue
        if name == "Duration":
            v = v * {"nsecond": 1e-3, "usecond": 1, "msecond": 1e3, "second": 1e6}.get(unit, 1)
        if name == "Memory Throughput" and unit.lower().startswith("gbyte"):
            d["gbs"] = v
        elif name in NCU_PICK:
            d.setdefault(NCU_PICK[name], v)
        elif name.startswith("Stall") or "issue_stalled" in name:
            d.setdefault("stalls", {})[re.sub(r".*stalled_(.*)_per_issue.*", r"\1", name)] = v
        elif a.stalls and "stalled" in name:
            d.setdefault("stalls", {})[name] = v
    names = demangle([k[1] for k in kers])
    rows, recs, notes = [], [], []
    for (key, d), n in zip(kers.items(), names):
        cls = classify(d)
        rows.append([key[0], short(n, 36), f"{d.get('dur', 0):.1f}", f"{d.get('sm', 0):.0f}", f"{d.get('dram', 0):.0f}", f"{d.get('l2', 0):.0f}", f"{d.get('l1', 0):.0f}",
                     f"{d.get('occ', 0):.0f}/{d.get('tocc', 0):.0f}", f"{d.get('reg', 0):.0f}", f"{d.get('waves', 0):.2f}", f"{d.get('cpi', 0):.1f}", cls])
        recs.append(dict(id=key[0], kernel=n, dur_us=d.get("dur"), sm_pct=d.get("sm"), dram_pct=d.get("dram"),
                         l2_pct=d.get("l2"), l1_pct=d.get("l1"), gbs=d.get("gbs"),
                         occ=d.get("occ"), occ_theory=d.get("tocc"), regs=d.get("reg"), waves=d.get("waves"),
                         cpi=d.get("cpi"), class_=cls, stalls=d.get("stalls", {})))
        if d.get("waves", 9) < 0.5 and d.get("dur", 0) > 8:
            notes.append(f"{key[0]}: waves/SM {d['waves']:.2f} -> grid too small to fill GPU")
        elif d.get("waves", 0) and abs(d["waves"] - round(d["waves"])) > 0.25 and d["waves"] < 4:
            notes.append(f"{key[0]}: waves/SM {d['waves']:.2f} -> tail effect")
        if d.get("occ", 100) < 0.6 * d.get("tocc", 0):
            notes.append(f"{key[0]}: achieved occ {d['occ']:.0f} << theoretical {d['tocc']:.0f} -> imbalance/tail")
        if d.get("l2hit", 100) < 40 and d.get("dram", 0) > 50:
            notes.append(f"{key[0]}: L2 hit {d['l2hit']:.0f}% with high dram -> poor reuse")
        if d.get("bank", 0) > 1.5:
            notes.append(f"{key[0]}: smem bank conflicts x{d['bank']:.1f}")
        if d.get("stalls"):
            top = sorted(d["stalls"].items(), key=lambda x: -x[1])[:3]
            notes.append(f"{key[0]} stalls: " + " ".join(f"{k}={v:.1f}" for k, v in top))
    if a.json:
        out(dict(kernels=recs, notes=notes))
        return
    table(rows, ["id", "kernel", "us", "sm%", "dram%", "l2%", "l1%", "occ/th", "reg", "waves", "cpi", "class"], right=range(2, 11))
    for n in notes:
        print(" ", n)


def sass_mix(path):
    r = sh(["cuobjdump", "-sass", str(path)])
    cur, funcs = None, {}
    for line in r.stdout.splitlines():
        m = re.match(r"\s*Function : (\S+)", line)
        if m:
            cur = m[1]
            funcs[cur] = {}
            continue
        m = re.match(r"\s*/\*[0-9a-f]+\*/\s+(.*?);", line)
        if not m or not cur:
            continue
        body = re.sub(r"^@!?P\d+\s+", "", m[1].strip())
        op = body.split()[0].split(".")[0]
        f = funcs[cur]
        f[op] = f.get(op, 0) + 1
        f["TOTAL"] = f.get("TOTAL", 0) + 1
    return funcs


def cmd_sass(a):
    cc = (smi("compute_cap") or ["8.6"])[0].replace(".", "")
    p = Path(a.path)
    if not p.exists():
        sys.exit(f"no {p}")
    src = p.suffix == ".cu"
    if a.arch in (None, "current"):
        m = None if src else re.search(r"(?:sm[_-]?|cc)(\d+)", p.name)
        arches = [f"sm_{m[1]}" if m else f"sm_{cc}"]
    elif a.arch == "all":
        arches = ["sm_80", "sm_90", "sm_120"]
    else:
        arches = [x if x.startswith("sm_") else f"sm_{x}" for x in a.arch.split(",")]
    tmp = Path(tempfile.mkdtemp())
    recs, errors = [], []
    for arch in arches:
        cub = p
        if src:
            cub = tmp / f"k_{arch}.cubin"
            r = sh(["nvcc", "-O3", "-std=c++17", "-cubin", f"-arch={arch}", "-o", str(cub), str(p)] + a.nvcc)
            if r.returncode:
                msg = (r.stderr or r.stdout).strip().splitlines()[-1][:160]
                errors.append(dict(arch=arch, error=msg))
                if not a.json:
                    print(f"{arch}: compile failed: {msg}")
                continue
        ru = {f: u for f, u in resource_usage(cub)}
        mix = sass_mix(cub)
        names = demangle(list(mix))
        for mangled, n in zip(mix, names):
            if a.filter and not re.search(a.filter, n):
                continue
            u, m = ru.get(mangled, {}), mix[mangled]
            regs, stack, sm, loc = u.get("REG", 0), u.get("STACK", 0), u.get("SHARED", 0), u.get("LOCAL", 0)
            blk, occ, why, _ = occupancy(regs, sm, a.block, arch.replace("sm_", ""))
            recs.append(dict(arch=arch, kernel=n, regs=regs, stack=stack, smem=sm, lmem=loc,
                             sass=m.get("TOTAL", 0), ffma=m.get("FFMA", 0), hmma=m.get("HMMA", 0),
                             mma=m.get("MMA", 0), ldsm=m.get("LDSM", 0), ldgsts=m.get("LDGSTS", 0),
                             ldg=m.get("LDG", 0), lds=m.get("LDS", 0), stg=m.get("STG", 0),
                             blocks=blk, occ_pct=round(occ, 1), limit=why))
    recs.sort(key=lambda x: (x["arch"], -x["sass"]))
    recs = recs[: a.top]
    if a.json:
        out(dict(cc=cc, arches=arches, kernels=recs, errors=errors))
        return
    rows = []
    for r in recs:
        flags = []
        if r["stack"] or r["lmem"]:
            flags.append(f"spill stack={r['stack']} local={r['lmem']}")
        if r["occ_pct"] < 50:
            flags.append(f"lowocc<-{r['limit']}")
        rows.append([r["arch"].replace("sm_", ""), short(r["kernel"], 38), r["regs"], r["stack"], r["smem"],
                     r["sass"], r["ffma"], r["hmma"] + r["mma"], r["ldsm"], r["ldgsts"],
                     f"{r['occ_pct']:.0f}%", " ".join(flags)])
    if rows:
        table(rows, ["cc", "kernel", "reg", "stk", "smem", "sass", "ffma", "hmma", "ldsm", "ldgst", "occ", "flags"], right=range(2, 11))
    else:
        print("no kernels matched")
    print("sass=static instructions; hmma includes mma; occ assumes block=%d" % a.block)


