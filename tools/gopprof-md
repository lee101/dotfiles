#!/usr/bin/env python3
"""gopprof-md - run a Go binary under CPU profiling and emit a COMPACT markdown report.

Why this exists: a flamegraph SVG is tens of thousands of tokens and mostly geometry, so
pasting one into an agent context is wasteful and hard to reason over. `go tool pprof -top`
is better but still noisy, and cumulative-vs-flat confusion makes it easy to "optimise" a
function that is only a caller. This emits a small, decision-shaped table: where time is
actually spent (flat), what dominates the call tree (cumulative), and the package-level
rollup that usually tells you which subsystem to attack.

Usage:
  gopprof-md -- ./mybin subcmd --flags...          # profile a run
  gopprof-md --prof existing.prof --bin ./mybin    # report on an existing profile
  gopprof-md --top 25 --out report.md -- ./mybin ...

The profiled binary must honour BINANCEGO_CPUPROFILE (or pass --env NAME to use another
env var, or --flag '--cpuprofile=%s' for binaries that take a flag instead).
"""
from __future__ import annotations
import argparse, os, re, subprocess, sys, tempfile
from collections import defaultdict


def run_profiled(cmd, prof_path, env_var, flag_tpl, timeout):
    env = dict(os.environ)
    argv = list(cmd)
    if flag_tpl:
        argv.append(flag_tpl % prof_path)
    else:
        env[env_var] = prof_path
    started = os.times()
    proc = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=timeout)
    elapsed = os.times().elapsed - started.elapsed
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout[-2000:] + proc.stderr[-2000:])
        raise SystemExit(f"profiled command failed rc={proc.returncode}")
    return elapsed


def pprof_lines(binary, prof, mode, top):
    """mode: 'flat' (-top) or 'cum' (-top -cum)."""
    cmd = ["go", "tool", "pprof", "-top", "-nodecount", str(top * 3)]
    if mode == "cum":
        cmd.append("-cum")
    cmd += ([binary] if binary else []) + [prof]
    out = subprocess.run(cmd, capture_output=True, text=True)
    if out.returncode != 0:
        raise SystemExit(out.stderr.strip()[:1500])
    rows, total = [], None
    for line in out.stdout.splitlines():
        m = re.match(r"^\s*Duration:.*Total samples = ([\d.]+)(\w+)", line)
        if m:
            total = f"{m.group(1)}{m.group(2)}"
        # flat flat% sum% cum cum% name
        m = re.match(r"^\s*([\d.]+\w*)\s+([\d.]+)%\s+([\d.]+)%\s+([\d.]+\w*)\s+([\d.]+)%\s+(.+)$", line)
        if m:
            rows.append({
                "flat": m.group(1), "flat_pct": float(m.group(2)),
                "cum": m.group(4), "cum_pct": float(m.group(5)),
                "fn": m.group(6).strip(),
            })
    return rows, total


def shorten(fn, width=62):
    fn = re.sub(r"^github\.com/[^/]+/", "", fn)
    return fn if len(fn) <= width else fn[: width - 1] + "…"


def package_of(fn):
    fn = re.sub(r"^github\.com/[^/]+/", "", fn)
    head = fn.split("(")[0]
    parts = head.split("/")
    if len(parts) > 1:
        return "/".join(parts[:-1]) + "/" + parts[-1].split(".")[0]
    return head.split(".")[0] or "runtime"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--prof", default="", help="reuse an existing profile instead of running")
    ap.add_argument("--bin", default="", help="binary matching the profile (improves symbolisation)")
    ap.add_argument("--top", type=int, default=20)
    ap.add_argument("--out", default="", help="write markdown here instead of stdout")
    ap.add_argument("--env", default="BINANCEGO_CPUPROFILE", help="env var the binary reads for the profile path")
    ap.add_argument("--flag", default="", help="e.g. '--cpuprofile=%%s' if the binary takes a flag")
    ap.add_argument("--timeout", type=float, default=1800)
    ap.add_argument("cmd", nargs=argparse.REMAINDER)
    args = ap.parse_args()
    cmd = [c for c in args.cmd if c != "--"]

    tmp = None
    elapsed = None
    if args.prof:
        prof, binary = args.prof, args.bin
    else:
        if not cmd:
            raise SystemExit("give a command after -- (or use --prof)")
        tmp = tempfile.NamedTemporaryFile(suffix=".prof", delete=False)
        tmp.close()
        prof = tmp.name
        binary = args.bin or cmd[0]
        elapsed = run_profiled(cmd, prof, args.env, args.flag, args.timeout)

    flat, total = pprof_lines(binary, prof, "flat", args.top)
    cum, _ = pprof_lines(binary, prof, "cum", args.top)
    if not flat:
        raise SystemExit("no samples: is the binary honouring the profile env var, and did the run last long enough?")

    by_pkg = defaultdict(float)
    for r in flat:
        by_pkg[package_of(r["fn"])] += r["flat_pct"]

    L = []
    L.append("# CPU profile")
    meta = [f"samples **{total}**"] if total else []
    if elapsed:
        meta.append(f"wall **{elapsed:.1f}s**")
    if cmd:
        meta.append("`" + " ".join(os.path.basename(cmd[0]) for _ in [0]) + " " + " ".join(cmd[1:3]) + " …`")
    if meta:
        L.append(" · ".join(meta))
    L.append("")
    L.append("## Where time is actually spent (flat)")
    L.append("| flat% | cum% | function |")
    L.append("|---:|---:|---|")
    for r in flat[: args.top]:
        L.append(f"| {r['flat_pct']:.1f} | {r['cum_pct']:.1f} | `{shorten(r['fn'])}` |")
    L.append("")
    L.append("## What dominates the call tree (cumulative)")
    L.append("| cum% | function |")
    L.append("|---:|---|")
    seen = set()
    for r in cum:
        if r["fn"] in seen:
            continue
        seen.add(r["fn"])
        L.append(f"| {r['cum_pct']:.1f} | `{shorten(r['fn'])}` |")
        if len(seen) >= args.top:
            break
    L.append("")
    L.append("## Rollup by package (flat%)")
    L.append("| flat% | package |")
    L.append("|---:|---|")
    for pkg, pct in sorted(by_pkg.items(), key=lambda kv: -kv[1])[:12]:
        L.append(f"| {pct:.1f} | `{pkg}` |")
    L.append("")
    gc = sum(p for k, p in by_pkg.items() if k.startswith("runtime"))
    L.append(f"_runtime (GC/alloc/scheduler) accounts for **{gc:.1f}%** of flat time._")
    L.append("")
    L.append(f"_profile: `{prof}`  ·  drill down: `go tool pprof -list '<fn>' {binary} {prof}`_")

    md = "\n".join(L)
    if args.out:
        open(args.out, "w").write(md + "\n")
        print(f"wrote {args.out} ({len(md.splitlines())} lines)")
    else:
        print(md)


if __name__ == "__main__":
    main()
